# ─── Site ──────────────────────────────────────────────────────────────────
# Production domain, no trailing slash. Used for canonical URLs, sitemap,
# robots.txt, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.tegelhandelnelissen.nl

# Which deployment this is: production | acceptance | preview | development.
# Drives two things at once — whether crawlers may index the site, and whether
# outgoing mail is real or a labelled test send to CONTACT_TO_TEST.
#
# Unset means NON-production, deliberately: a forgotten value costs a noindexed
# site or a test email, never an indexed acceptance site or a customer enquiry
# delivered to a mailbox nobody reads.
#
# Read at build AND runtime — see the note in DEPLOYMENT.md before changing how
# it is passed to Docker.
APP_ENV=development

# ─── SMTP (server-side contact e-mail) ───────────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
# true for port 465 (implicit TLS), false for 587 (STARTTLS). Defaults to
# true when omitted on port 465.
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Where mail goes when APP_ENV is not "production". Every message — including
# the visitor's confirmation — is diverted here and prefixed [TEST], so a form
# submission on acceptance can never look like a real enquiry in the business's
# inbox. Falls back to CONTACT_FROM when unset.
CONTACT_TO_TEST=

# Inbox that contact-form submissions are delivered to.
CONTACT_TO=info@tegelhandelnelissen.nl
# From address shown on outgoing mail (use a domain mailbox, not the visitor's).
CONTACT_FROM=noreply@tegelhandelnelissen.nl

# ─── Analytics (optional) ────────────────────────────────────────────────────
# Google Analytics measurement id. Loaded only after the visitor accepts
# statistics cookies. Production uses G-7FN28L6211, set as the GitHub Actions
# repo variable NEXT_PUBLIC_GA_ID; leave blank locally so dev traffic stays
# out of the property.
NEXT_PUBLIC_GA_ID=
